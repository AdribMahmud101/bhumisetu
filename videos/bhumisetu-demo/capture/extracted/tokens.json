  "sections": [
    {
      "selector": "section",
      "type": "hero",
      "x": 0,
      "y": 168,
      "width": 1920,
      "height": 579,
      "heading": "জমির নথি হোক স্বচ্ছ। সিদ্ধান্ত হোক নিশ্চিন্ত।",
      "backgroundColor": "#FAFBF9",
      "callsToAction": [
        "যাচাই করুন",
        "LND-MOCK-001"
      ],
      "text": "নথি থেকে নির্ভরযোগ্য সিদ্ধান্ত জমির নথি হোক স্বচ্ছ। সিদ্ধান্ত হোক নিশ্চিন্ত। খতিয়ান, পর্চা, দলিল ও নামজারি—এক ঠিকানায়। জমি কেনার আগে দেখুন নথির ইতিহাস, অমিল এবং সম্ভাব্য দ্বৈত বিক্রয়ের প্রমাণ। যাচাই করুন কাল্পনিক রেকর্ড দেখুন LND-MOCK-001 প্রমাণভিত্তিক বিশ্লেষণ নথির ডিজিটাল অখণ্ডতা একটি জমি। সব নথি। স্পষ্ট চিত্র। দাগ নং ২০৭ কাল্পনিক জমির চিত্র · মানচিত্র নয় সমন্বিত ভূমি রেকর্ড খতিয়ান · পর্চা · দলিল · নামজারি নথির ইতিহাস প্রমাণসহ রিপোর্ট",
      "layout": "centered",
      "assetUrls": []
    },
    {
      "selector": "section",
      "type": "content",
      "x": 352,
      "y": 746,
      "width": 1216,
      "height": 443,
      "heading": "ভূমি যাচাই এখন আরও সহজ",
      "backgroundColor": "#FAFBF9",
      "callsToAction": [
        "জমির রেকর্ড অনুসন্ধানভূমি রেকর্ড খুঁজুনইউনিক আইডি দিয়ে একসা",
        "দলিলের তথ্য যাচাইনথি যাচাই করুনসংরক্ষিত নথির সঙ্গে কপি ও তথ্",
        "দ্বৈত বিক্রয় শনাক্তকরণবিক্রয়ে সংঘাত শনাক্ত করুনসম্ভাব্য সং",
        "স্মার্ট নামজারি পর্যালোচনানামজারি পর্যালোচনানথির অসংগতি যাচা"
      ],
      "text": "নাগরিক সেবা ভূমি যাচাই এখন আরও সহজ একটি জমির সম্পূর্ণ চিত্র, এক প্ল্যাটফর্মে। জমির রেকর্ড অনুসন্ধান ভূমি রেকর্ড খুঁজুন ইউনিক আইডি দিয়ে একসাথে সব নথি খুঁজুন। সেবা গ্রহণ করুন দলিলের তথ্য যাচাই নথি যাচাই করুন সংরক্ষিত নথির সঙ্গে কপি ও তথ্য মিলিয়ে দেখুন। সেবা গ্রহণ করুন দ্বৈত বিক্রয় শনাক্তকরণ বিক্রয়ে সংঘাত শনাক্ত করুন সম্ভাব্য সংঘাত দেখুন কারণ ও প্রমাণসহ। সেবা গ্রহণ করুন স্মার্ট নামজারি পর্যালোচনা নামজারি পর্যালোচনা নথির অসংগতি যাচাই করে সিদ্ধান্ত নিন। সেবা গ্রহণ করুন",
      "layout": "centered",
      "assetUrls": []
    },
    {
      "selector": "#how-it-works",
      "type": "features",
      "x": 0,
      "y": 1189,
      "width": 1920,
      "height": 216,
      "heading": "আপনার সিদ্ধান্তের পাশে প্রমাণ",
      "backgroundColor": "#F1F5ED",
      "callsToAction": [],
      "text": "সহজ তিনটি ধাপ আপনার সিদ্ধান্তের পাশে প্রমাণ স্বয়ংক্রিয় তথ্য বিশ্লেষণ · নিয়ম কারণ দেখায় · কর্মকর্তা সিদ্ধান্ত নেন 01 জমি খুঁজুন ইউনিক আইডি দিয়ে প্রকাশিত রেকর্ড খুলুন। 02 প্রমাণ দেখুন দলিল, জমির পরিমাণ ও ইতিহাস মিলিয়ে দেখুন। 03 জেনে সিদ্ধান্ত নিন অমিল ও অসম্পূর্ণ যাচাই বুঝে পরবর্তী পদক্ষেপ নিন।",
      "layout": "centered",
      "assetUrls": []
    }
  ],
